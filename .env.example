# Flight Agent local configuration template.
# Copy this file to .env for local-only values. Do not commit .env.

# Runtime environment. Expected values will be finalized by later M0 units.
FLIGHT_AGENT_ENV=local

# Backend configuration placeholders. Concrete settings contracts are deferred
# to later backend/runtime units.
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=8000

# Frontend configuration placeholders. Concrete settings contracts are deferred
# to later frontend/runtime units.
# FRONTEND_HOST=127.0.0.1
# FRONTEND_PORT=5173

# External services are intentionally left unset in M0-U1.
# DATABASE_URL=
# FLIGHT_PROVIDER_API_KEY=
# LLM_API_KEY=
