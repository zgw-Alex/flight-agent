# Flight Agent local configuration template.
# Copy this file to .env for local-only values. Do not commit .env.

# Runtime environment.
APP_ENV=local

# Backend application binding.
APP_HOST=127.0.0.1
APP_PORT=8000

# Frontend configuration placeholders. Concrete settings contracts are deferred
# to later frontend/runtime units.
# FRONTEND_HOST=127.0.0.1
# FRONTEND_PORT=5173

# Local PostgreSQL Docker Compose service.
# Host port 55432 avoids local PostgreSQL services on 5432 and 5433.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=flight_agent
POSTGRES_USER=flight_agent
POSTGRES_PASSWORD=flight_agent_local_password

# DATABASE_URL is derived from POSTGRES_* settings in backend code.
# FLIGHT_PROVIDER_API_KEY=

# DeepSeek real LLM smoke is explicit and excluded from ordinary CI.
# Keep the key local-only in .env; never commit a real secret.
# DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=15
DEEPSEEK_TOTAL_DEADLINE_SECONDS=30
DEEPSEEK_MAX_ATTEMPTS=2
